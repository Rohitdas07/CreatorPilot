{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Creator account profile linked to Firebase Auth UID (never stores passwords).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Creator full display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160,
          "description": "Registered email address."
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^\\+[0-9]{1,5}$",
          "description": "International dialing prefix such as +1 or +91."
        },
        "phoneNumber": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "description": "Formatted phone number with country code."
        },
        "brandHandle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60,
          "description": "Creator social handle."
        },
        "niche": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Creator content niche."
        },
        "brandVoice": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400,
          "description": "Customizable creator brand voice guidelines."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "countryCode",
        "phoneNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreatorProject": {
      "title": "CreatorProject",
      "description": "Saved creator project containing input configuration and AI-generated multi-platform content.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Project document ID."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Project title."
        },
        "config": {
          "type": "object",
          "description": "Generation configuration including sourceText, platform, language, tone, duration, niche, and brandVoice."
        },
        "result": {
          "type": "object",
          "description": "Structured multi-platform generated content bundle including analysis, hooks, scripts, captions, hashtags, and posts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when project was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when project was last updated."
