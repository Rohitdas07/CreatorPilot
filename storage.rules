rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Brand Kit logos and visual brand assets
    match /users/{userId}/brand-assets/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Rendered MP4 videos from AI Smart Video Editor
    match /users/{userId}/rendered-videos/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(userId);
    }

    // Thumbnail Studio exports
    match /users/{userId}/thumbnails/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }
  }
}
