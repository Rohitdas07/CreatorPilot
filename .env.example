# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this value in your deployment environment or local secrets.
# Configure this key using your deployment platform's secrets settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Set this to the URL where the CreatorPilot AI app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Social Media Official OAuth Credentials (configure via Settings > Secrets)
# Meta App (supports Instagram Professional + Facebook Pages)
META_APP_ID=""
META_APP_SECRET=""
# Optional platform-specific overrides for Instagram / Facebook:
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# YouTube (Google Cloud OAuth 2.0 Client with YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# LinkedIn (LinkedIn Developer App with Sign In with LinkedIn + Share on LinkedIn)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Optional 32-byte hex/passphrase key for backend token vault encryption
SOCIAL_TOKEN_ENCRYPTION_KEY=""

